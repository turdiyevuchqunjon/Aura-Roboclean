# Sayt manzili (TG'dagi to'lov havolasi uchun) — oxirida / qo'ymang
NEXT_PUBLIC_SITE_URL=https://robaclean.uz

# Meta Pixel + Conversions API
NEXT_PUBLIC_META_PIXEL_ID=000000000000000
META_CAPI_TOKEN=EAAG...
# Test paytida Events Manager > Test events kodini yozing, ishga tushganda bo'sh qoldiring
META_TEST_EVENT_CODE=
META_API_VERSION=v23.0

# Telegram bot
TELEGRAM_BOT_TOKEN=123456:ABC...
# Bir nechta chat bo'lsa vergul bilan: -1001234567890,123456789
TELEGRAM_CHAT_ID=-1001234567890

# To'lov havolalarini imzolash uchun maxfiy kalit (uzun tasodifiy satr)
ADMIN_SECRET=change-me-to-long-random-string

# Ixtiyoriy: Upstash Redis — to'lov ikki marta kiritilishining oldini oladi
